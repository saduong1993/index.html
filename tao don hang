          {["hangTMDT", "hangTap", "nhapKinhDoanh", "nhapChuyenKhau"].includes(formData.loaiHinh) && (
            <>
              <Select name="benDichVuThongQuan" onValueChange={(value) => setFormData({ ...formData, benDichVuThongQuan: value })}>
  <SelectTrigger><SelectValue placeholder="Bên dịch vụ thông quan" /></SelectTrigger>
  <SelectContent>
    {["NGUYÊN KHÁNH", "STALI", "ALB", "KVMB", "KHÁC"].map((item) => (
      <SelectItem key={item} value={item}>{item}</SelectItem>
    ))}
  </SelectContent>
</Select>
              <Select name="diaChiKhoGiaoHang" onValueChange={(value) => setFormData({ ...formData, diaChiKhoGiaoHang: value })}>
  <SelectTrigger><SelectValue placeholder="Địa chỉ kho giao hàng" /></SelectTrigger>
  <SelectContent>
    {["HNT", "KVMB", "KHÁC"].map((item) => (
      <SelectItem key={item} value={item}>{item}</SelectItem>
    ))}
  </SelectContent>
</Select>
            </>
          )}

          <div className="col-span-2 flex justify-end">
            <Button type="submit">Lưu đơn hàng</Button>
          </div>
        </form>
      </CardContent>
