    "Chi Men": ["YL130", "YL155", "YL156", "YL157", "YL158", "YL159", "YL160", "YL665"],
    "189 Logistics": ["YL189"], "anh Duy hải quan": ["YL190"], "a Tiệp aru": ["YL191"],
    "Hoàng Con - Hương Cua": ["YL121", "YL192", "YL193", "YL194", "YL195", "YL129", "YL126", "YL102", "YL103", "YL101", "YL333"],
    "Hoa kichi": ["YL162"], "NHC": ["YL314"], "Eric Ruan": ["YL161"], "Linh": ["YL164"], "T": ["YL163"],
    "天意": ["YL309"], "c Hường (Ngô Hường)": ["YL136"], "Minh Bình": ["YL137"], "Duy Bách  ( HP )": ["YL201"],
    "Anh Cảnh": ["YL79-1", "YL79-5", "YL79-7", "YL79-2", "YL793", "YL79-9", "YL-NA71"], "Sergei": ["YL294"]
  };

  const [formData, setFormData] = useState({
    benDichVuThongQuan: "",
    diaChiKhoGiaoHang: "",
    loaiHinh: "",
    tenHang: "",
    khachHang: "",
    maDaiLy: "",
    diemDi: "",
    diemDen: "",
    cuaKhau: "",
    loaiXeTQ: "",
    loaiXeVN: "",
    vanChuyenBo: false,
    vanChuyenBay: false,
    vanChuyenBien: false,
    nhaCungCapBo: "",
    nhaCungCapBay: "",
    nhaCungCapBien: "",
    maDonHang: "",
    congTyKhaiBao: "",
    soMAWB: "",
    soToKhai: "",
    ngayTaoDon: "",
    soXeTQ: "",
    trongLuong: "",
    soKien: "",
    triGiaUSD: "",
    soXeVN: "",
    ghiChu: "",
    trangThai: ""
  });

  const handleChange = (e) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  const handleLoaiHinhChange = (value) => {
    const today = new Date();
    const yyyyMMdd = today.toISOString().split("T")[0].replace(/-/g, "");
    const stt = Math.floor(Math.random() * 900 + 100);
    const prefixMap = {
      hangLe: "HL",
      hangTMDT: "TMDT",
      nhapKinhDoanh: "KD",
      nhapChuyenKhau: "NCK",
      xuatChuyenKhau: "XCK",
      hangTap: "TAP"
    };
    const hangMap = {
      hangLe: "HÀNG LẺ",
      hangTMDT: "TMDT",
      nhapKinhDoanh: "NHẬP KINH DOANH",
      nhapChuyenKhau: "NHẬP CHUYỂN KHẨU",
      xuatChuyenKhau: "XUẤT KHẨU",
      hangTap: "TẠP"
    };
    const prefix = prefixMap[value] || value.toUpperCase();
    const autoMa = `${prefix}_${yyyyMMdd}_${stt}`;
    setFormData({
      ...formData,
      loaiHinh: value,
      maDonHang: autoMa,
      tenHang: hangMap[value] || ""
    });
  };

