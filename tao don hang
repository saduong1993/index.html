            <SelectContent>
              {["Hà Nội", "Hồ Chí Minh", "Đà Nẵng", "Hải Phòng", "KHÁC"].map((tp) => (
                <SelectItem key={tp} value={tp}>{tp}</SelectItem>
              ))}
            </SelectContent>
          </Select>

          <Select onValueChange={(value) => setFormData({ ...formData, cuaKhau: value })}>
            <SelectTrigger><SelectValue placeholder="Cửa khẩu" /></SelectTrigger>
            <SelectContent>
              {["TÂN THANH", "HỮU NGHỊ", "CHI MA", "KHÁC"].map((ck) => (
                <SelectItem key={ck} value={ck}>{ck}</SelectItem>
              ))}
            </SelectContent>
          </Select>

          <Select onValueChange={(value) => setFormData({ ...formData, loaiXeTQ: value })}>
            <SelectTrigger><SelectValue placeholder="Loại xe Trung Quốc" /></SelectTrigger>
            <SelectContent>
              {["9M6", "13M", "13M5", "16M", "16M2", "16M5", "17M", "17M5", "18M", "KHÁC"].map((xe) => (
                <SelectItem key={xe} value={xe}>{xe}</SelectItem>
              ))}
            </SelectContent>
          </Select>

          <Select onValueChange={(value) => setFormData({ ...formData, loaiXeVN: value })}>
            <SelectTrigger><SelectValue placeholder="Loại xe Việt Nam" /></SelectTrigger>
            <SelectContent>
              {["1,5 TẤN", "2,5 TẤN", "3 TẤN", "5 TẤN", "8 TẤN", "10 TẤN", "MOOC RÀO", "CONT 45", "CONT 50", "CONT 53", "CONT", "KHÁC"].map((xe) => (
                <SelectItem key={xe} value={xe}>{xe}</SelectItem>
              ))}
            </SelectContent>
          </Select>

          <Input name="congTyKhaiBao" value={formData.congTyKhaiBao} onChange={handleChange} placeholder="Công ty khai báo" />
          <Input name="soMAWB" value={formData.soMAWB} onChange={handleChange} placeholder="Số MAWB / Invoice" />
          <Input name="soToKhai" value={formData.soToKhai} onChange={handleChange} placeholder="Số tờ khai" />
          <Input name="ngayTaoDon" value={formData.ngayTaoDon} onChange={handleChange} placeholder="Ngày tạo đơn" />
          <Input name="soXeTQ" value={formData.soXeTQ} onChange={handleChange} placeholder="Số xe TQ" />
          <Input name="soXeVN" value={formData.soXeVN} onChange={handleChange} placeholder="Số xe VN" />
          <Input name="trongLuong" value={formData.trongLuong} onChange={handleChange} placeholder="Trọng lượng hàng" />
          <Input name="soKien" value={formData.soKien} onChange={handleChange} placeholder="Số kiện" />
          <Input name="triGiaUSD" value={formData.triGiaUSD} onChange={handleChange} placeholder="Tổng trị giá USD" />

          <Textarea name="ghiChu" value={formData.ghiChu} onChange={handleChange} placeholder="Ghi chú chi tiết về đơn hàng..." />
          <Input name="trangThai" value={formData.trangThai} onChange={handleChange} placeholder="Trạng thái đơn hàng" />

          <div className="col-span-2">
            <label className="block mb-1 font-medium">Hình thức vận chuyển</label>
            <div className="flex gap-4">
              <label className="flex items-center space-x-2">
                <input type="checkbox" checked={formData.vanChuyenBo} onChange={handleCheckboxChange('vanChuyenBo')} />
                <span>Đường bộ</span>
              </label>
              <label className="flex items-center space-x-2">
                <input type="checkbox" checked={formData.vanChuyenBay} onChange={handleCheckboxChange('vanChuyenBay')} />
                <span>Đường bay</span>
              </label>
              <label className="flex items-center space-x-2">
                <input type="checkbox" checked={formData.vanChuyenBien} onChange={handleCheckboxChange('vanChuyenBien')} />
                <span>Đường biển</span>
              </label>
            </div>
