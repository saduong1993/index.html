          {khachHangOptions ? (
            <Select onValueChange={(value) => setFormData({ ...formData, khachHang: value })}>
              <SelectTrigger><SelectValue placeholder="Tên khách hàng" /></SelectTrigger>
              <SelectContent>
                {khachHangOptions.map((kh) => <SelectItem key={kh} value={kh}>{kh}</SelectItem>)}
              </SelectContent>
            </Select>
          ) : (
            <Input name="khachHang" value={formData.khachHang} onChange={handleChange} placeholder="Tên khách hàng" />
          )}

          {maDaiLyOptions.length > 0 && (
            <Select onValueChange={(value) => setFormData({ ...formData, maDaiLy: value })}>
              <SelectTrigger><SelectValue placeholder="Mã đại lý" /></SelectTrigger>
              <SelectContent>
                {maDaiLyOptions.map((ma) => <SelectItem key={ma} value={ma}>{ma}</SelectItem>)}
              </SelectContent>
            </Select>
          )}

          <Input name="diemDi" value={formData.diemDi} onChange={handleChange} placeholder="Điểm đi" />

          <Select onValueChange={(value) => setFormData({ ...formData, diemDen: value })}>
